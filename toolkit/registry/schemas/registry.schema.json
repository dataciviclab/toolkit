{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "registry.schema.json",
  "title": "Lab Registry (v2)",
  "description": "Artifact registry unico per repo (schema v2): catalogo di discovery del repo. `gcs` + `datasets[].partitions` + `marts[].layout` determinano i path pubblicati; lo stato operativo vive in `datasets[].last_run`; `checks` contiene solo anomalie. Le sezioni v1 (`signals`, `entities`) e i campi editoriali di esecuzione (`stage`, `source`) non sono più prodotti. La compatibilità v1/v2 è in lab_connectors.registry.models.",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "updated_at",
    "datasets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "repo": {
      "type": "string"
    },
    "source_repo": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "gcs": {
      "type": "object",
      "description": "Contratto di pubblicazione del repo: i path non sono scritti voce per voce.",
      "properties": {
        "prefix": {
          "type": "string",
          "description": "Prefisso nel bucket, con trailing slash (es. 'open-politica/')."
        },
        "clean": {
          "type": "string",
          "enum": ["year", "flat"],
          "description": "Layout del layer clean: 'year' = {slug}/{year}/..., 'flat' = {slug}/{slug}_{year}_clean.parquet."
        }
      },
      "additionalProperties": false
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dataset"
      },
      "description": "Dataset del repo. I dataset mart-only non hanno clean: columns e partitions sono assenti."
    },
    "marts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mart"
      },
      "description": "Tabelle analitiche (mart) pubblicate, con il layout di partizionamento."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "description": "Anomalie riproducibili dal config (vuoto = tutto a posto)."
    },
    "codelists": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Nomi dei codelist del repo (contenuto letto dal CSV in repo, non embeddato)."
    }
  },
  "additionalProperties": true,
  "$defs": {
    "dataset": {
      "type": "object",
      "required": [
        "slug",
        "name",
        "period"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "description": "source_id corrispondente in source-observatory/sources_registry.yaml"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tag semantici per categorizzazione e raggruppamento batch"
        },
        "category": {
          "type": "string",
          "description": "Categoria principale del dataset (es. sanità, energia, finanza)"
        },
        "period": {
          "type": "object",
          "description": "Copertura dichiarata nel config (time_coverage) o estremi delle partizioni.",
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "type": "integer"
            },
            "end": {
              "type": "integer"
            }
          }
        },
        "partitions": {
          "type": "object",
          "description": "Partizioni clean pubblicate: chiave di partizione (anno o legislatura) -> righe del parquet. Assente per i mart-only e per le entry non ancora rieseguite.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "mart_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Slug dei mart del dataset ({dataset}__{table})."
        },
        "last_run": {
          "$ref": "#/$defs/last_run"
        },
        "location": {
          "type": "string",
          "description": "Override del path GCS (solo per pubblicazioni fuori contratto): normalmente assente e derivato da gcs + partitions."
        }
      }
    },
    "column": {
      "type": "object",
      "required": [
        "name",
        "type",
        "role"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": ["dimension", "metric"]
        },
        "description": {
          "type": "string",
          "description": "Descrizione editoriale (assente se vuota)."
        },
        "semantic_type": {
          "type": "string",
          "description": "Tipo semantico dal vocabolario condiviso (semantic_types.yaml)."
        }
      }
    },
    "last_run": {
      "type": "object",
      "description": "Esecuzione più recente su tutte le partizioni (non l'anno più alto).",
      "required": [
        "at",
        "year",
        "status"
      ],
      "properties": {
        "at": {
          "type": "string",
          "description": "started_at ISO 8601 (UTC) della run."
        },
        "year": {
          "type": "integer",
          "description": "Chiave di partizione della run (anno o legislatura)."
        },
        "status": {
          "type": "string",
          "description": "Stato della run (SUCCESS/FAILED/RUNNING/DRY_RUN/ABORTED)."
        }
      }
    },
    "mart": {
      "type": "object",
      "required": [
        "slug",
        "dataset",
        "table",
        "layout"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "description": "{dataset}__{table}"
        },
        "dataset": {
          "type": "string"
        },
        "table": {
          "type": "string"
        },
        "layout": {
          "type": "string",
          "enum": ["flat", "year", "glob"],
          "description": "flat = {dataset}/{table}.parquet; year = {dataset}/{year}/{table}.parquet; glob = {dataset}/*/{table}.parquet."
        },
        "year": {
          "type": "integer",
          "description": "Obbligatorio con layout=year."
        },
        "primary_key": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Chiave primaria dichiarata in dataset.yml (mart.validate.table_rules)."
        },
        "location": {
          "type": "string",
          "description": "Override del path GCS (normalmente assente e derivato)."
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Slug del dataset (o nome del controllo)."
        },
        "status": {
          "type": "string",
          "enum": ["warn", "error"]
        },
        "detail": {
          "type": "string"
        },
        "action": {
          "type": "string"
        }
      }
    }
  }
}
